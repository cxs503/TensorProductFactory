{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorproductfactory.dev/schemas/release.schema.json",
  "title": "Release",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id", "product_id", "product_version", "manifest_id", "qa_report_id", "package_uri", "package_sha256", "released_at"],
  "properties": {
    "release_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "product_version": {"type": "string", "minLength": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "qa_report_id": {"type": "string", "minLength": 1},
    "package_uri": {"type": "string", "minLength": 1},
    "package_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "released_at": {"type": "string", "format": "date-time"}
  }
}
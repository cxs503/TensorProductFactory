{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorproductfactory.dev/schemas/qa-profile.schema.json",
  "title": "QARuleProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "version", "product_mode", "required_rule_ids"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "product_mode": {"enum": ["standard", "personalized", "software"]},
    "required_rule_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}